CREATE NODE TABLE `ResearchOutput` (`id` STRING,`publishDate` DATE,`teacherId` INT64,`outputtype` STRING,`citationCount` INT64,`level` STRING,`name` STRING,`title` STRING,`outputId` INT64, PRIMARY KEY(`id`));
CREATE NODE TABLE `Label` (`id` STRING,`labelId` STRING,`name` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `User` (`id` STRING,`gendercode` STRING,`personstatuscode` STRING,`idNumber` STRING,`userId` STRING,`organizationId` STRING,`idtypecode` STRING,`phoneNumber` STRING,`name` STRING,`email` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `Group` (`id` STRING,`statuscode` STRING,`grouptypecode` STRING,`name` STRING,`groupCode` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `EventOnlineDetail` (`id` STRING,`oldCampusCode` STRING,`accessDevicePort` STRING,`onlineSec` INT64,`operatorsSessionId` STRING,`accessCtrl` STRING,`terminalOperationSystem` STRING,`timesegmentId` STRING,`groupinfoUuid` STRING,`areaName` STRING,`operatorFirstLogin` DATE,`packetUuid` STRING,`nasName` STRING,`dns` STRING,`apMac` STRING,`onlineDetailUuid` STRING,`peVlan` INT64,`nasPort` INT64,`accountId` STRING,`logoutTime` DATE,`operatorsName` STRING,`tunnelClient` STRING,`ipv6Num` INT64,`ceVlan` INT64,`passThroughType` STRING,`nasPortId` STRING,`userIpv4` STRING,`accessEquipmentType` STRING,`userIpv6` STRING,`ssid` STRING,`accessType` INT64,`createHost` STRING,`loginTime` DATE,`nasIp` STRING,`suConnVersion` INT64,`finger` STRING,`isRoaming` BOOL,`gatewaystrategy` STRING,`oldCampusName` STRING,`sessionId` STRING,`userId` INT64,`totalTraffic` DOUBLE,`visitorAuthType` INT64,`hasReset` BOOL,`policyId` STRING,`userTemplateUuid` STRING,`createTime` DATE,`operatorUuid` STRING,`accessDeviceDescription` STRING,`proxyName` STRING,`serviceSuffix` STRING,`usergroupId` STRING,`lastUpdateHost` STRING,`nasType` STRING,`operator` STRING,`tunnelServer` STRING,`wpNasIp` STRING,`operatorsConfigUuid` STRING,`nasCommunity` STRING,`terminateCause` STRING,`usertemplateId` STRING,`operatorsUserId` STRING,`nasTypeNum` STRING,`clientHostname` STRING,`ipv6Gateway` STRING,`accessDeviceType` STRING,`accountingRule` STRING,`domainName` STRING,`name` STRING,`userType` STRING,`userMac` STRING,`lastUpdateTime` DATE,`userIpv6LocalLink` STRING,`acctSessionId` STRING,`suVersion` STRING,`terminalTypeDes` STRING,`nasIpv6` STRING,`accessDeviceInterface` STRING,`userVlan` INT64,`wpNasPort` INT64,`compusName` STRING,`groupinfoId` STRING,`packageName` STRING,`serviceId` STRING,`netMask` STRING,`isOperatorsAuth` BOOL,`accessDeviceIp` STRING,`nasLocation` STRING,`actualGatewayStrategy` STRING,`gateway` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `Teacher` (`id` STRING,`idCard` STRING,`secname` STRING,`isAdvisor` BOOL,`phone` STRING,`role` STRING,`gender` STRING,`email` STRING,`teacherId` INT64,`degree` STRING,`name` STRING,`title` STRING,`hireDate` DATE,`birthDate` DATE, PRIMARY KEY(`id`));
CREATE NODE TABLE `Post` (`id` STRING,`positiontypecode` STRING,`prioritycode` STRING,`postId` STRING,`name` STRING,`posttypecode` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `TeacherEducation` (`id` STRING,`educationEndDate` DATE,`teacherEducationId` INT64,`teacherId` INT64,`educationStartDate` DATE,`major` STRING,`school` STRING,`name` STRING,`degreetype` STRING,`isHighestDegree` BOOL, PRIMARY KEY(`id`));
CREATE NODE TABLE `EventTeacherComplaint` (`id` STRING,`handler` STRING,`isConfirmed` BOOL,`complaintContent` STRING,`status` STRING,`feedbackToStudent` STRING,`teacherId` INT64,`evidence` STRING,`complaintType` STRING,`complaintId` INT64,`name` STRING,`studentId` INT64,`handlingResult` STRING,`complaintDate` DATE, PRIMARY KEY(`id`));
CREATE NODE TABLE `EventCardConsume` (`id` STRING,`consumeTime` DATE,`userId` INT64,`usertype` STRING,`name` STRING,`consumeId` INT64,`amount` DOUBLE,`location` STRING,`category` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `AccessDevice` (`id` STRING,`access_device_ip` STRING,`access_device_type` STRING,`access_device_port` STRING,`access_device_description` STRING,`access_device_interface` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `EventTeacherDiscipline` (`id` STRING,`disciplineRecordId` INT64,`reportDate` DATE,`violationDate` DATE,`isResolved` BOOL,`punishment` STRING,`teacherId` INT64,`violationType` STRING,`name` STRING,`severitylevel` STRING,`resolutionDate` DATE,`remark` STRING,`investigator` STRING,`reportSource` STRING,`violationDetail` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `EventAuthLog` (`id` STRING,`idCard` STRING,`deviceType` STRING,`loginLocation` STRING,`authresult` STRING,`failReason` STRING,`authMethod` STRING,`usertype` STRING,`authDurationMs` INT64,`authLogId` INT64,`name` STRING,`authIp` STRING,`authTime` DATE,`browser` STRING,`username` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `NASDevice` (`id` STRING,`nas_ip` STRING,`nas_port` INT64,`nas_name` STRING,`nas_location` STRING,`nas_type` STRING,`nas_type_num` STRING,`nas_ipv6` STRING,`nas_community` STRING,`nas_port_id` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `TerminalDevice` (`id` STRING,`user_mac` STRING,`terminal_operation_system` STRING,`terminal_type_des` STRING,`access_equipment_type` STRING,`client_hostname` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `Area` (`id` STRING,`area_name` STRING,`compus_name` STRING,`old_campus_code` STRING,`old_campus_name` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `NetworkAccessPoint` (`id` STRING,`ap_mac` STRING,`ssid` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `IPAddress` (`id` STRING,`user_ipv4` STRING,`user_ipv6` STRING,`user_ipv6_local_link` STRING,`ipv6_num` INT64, PRIMARY KEY(`id`));
CREATE NODE TABLE `Gateway` (`id` STRING,`gateway` STRING,`gatewaystrategy` STRING,`ipv6_gateway` STRING,`dns` STRING,`domain_name` STRING,`net_mask` STRING,`actual_gateway_strategy` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `EventOnlineSession` (`id` STRING,`oldCampusCode` STRING,`accessDevicePort` STRING,`onlineSec` INT64,`operatorsSessionId` STRING,`accessCtrl` STRING,`terminalOperationSystem` STRING,`timesegmentId` STRING,`groupinfoUuid` STRING,`areaName` STRING,`operatorFirstLogin` DATE,`packetUuid` STRING,`nasName` STRING,`dns` STRING,`apMac` STRING,`onlineDetailUuid` STRING,`peVlan` INT64,`nasPort` INT64,`accountId` STRING,`logoutTime` DATE,`operatorsName` STRING,`tunnelClient` STRING,`ipv6Num` INT64,`ceVlan` INT64,`passThroughType` STRING,`nasPortId` STRING,`userIpv4` STRING,`accessEquipmentType` STRING,`userIpv6` STRING,`ssid` STRING,`accessType` INT64,`createHost` STRING,`loginTime` DATE,`nasIp` STRING,`suConnVersion` INT64,`finger` STRING,`isRoaming` BOOL,`gatewaystrategy` STRING,`oldCampusName` STRING,`sessionId` STRING,`totalTraffic` DOUBLE,`visitorAuthType` INT64,`hasReset` BOOL,`policyId` STRING,`userTemplateUuid` STRING,`createTime` DATE,`operatorUuid` STRING,`accessDeviceDescription` STRING,`proxyName` STRING,`serviceSuffix` STRING,`usergroupId` STRING,`lastUpdateHost` STRING,`nasType` STRING,`operator` STRING,`tunnelServer` STRING,`wpNasIp` STRING,`operatorsConfigUuid` STRING,`nasCommunity` STRING,`terminateCause` STRING,`usertemplateId` STRING,`operatorsUserId` STRING,`nasTypeNum` STRING,`clientHostname` STRING,`ipv6Gateway` STRING,`accessDeviceType` STRING,`accountingRule` STRING,`domainName` STRING,`userType` STRING,`userMac` STRING,`lastUpdateTime` DATE,`userIpv6LocalLink` STRING,`acctSessionId` STRING,`suVersion` STRING,`terminalTypeDes` STRING,`nasIpv6` STRING,`accessDeviceInterface` STRING,`userVlan` INT64,`wpNasPort` INT64,`compusName` STRING,`groupinfoId` STRING,`packageName` STRING,`serviceId` STRING,`netMask` STRING,`isOperatorsAuth` BOOL,`accessDeviceIp` STRING,`nasLocation` STRING,`actualGatewayStrategy` STRING,`gateway` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `Student` (`id` STRING,`idCard` STRING,`secname` STRING,`phone` STRING,`studentNo` STRING,`status` STRING,`gender` STRING,`email` STRING,`politicalStatus` STRING,`enrollmentYear` DATE,`name` STRING,`isPoor` BOOL,`studentId` INT64,`birthDate` DATE,`educationlevel` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `Service` (`id` STRING,`service_id` STRING,`package_name` STRING,`service_suffix` STRING,`accounting_rule` STRING,`policy_id` STRING,`timesegment_id` STRING,`usertemplate_id` STRING, PRIMARY KEY(`id`));
CREATE NODE TABLE `Operator` (`id` STRING,`operators_user_id` STRING,`operators_name` STRING,`operators_config_uuid` STRING,`proxy_name` STRING, PRIMARY KEY(`id`));
CREATE REL TABLE `EventAuthLog_performedBy_Student` (FROM `EventAuthLog` TO `Student`, MANY_ONE);
CREATE REL TABLE `User_hasPosition_Post` (FROM `User` TO `Post`, MANY_MANY);
CREATE REL TABLE `ResearchOutput_authoredBy_Teacher` (FROM `ResearchOutput` TO `Teacher`, MANY_MANY);
CREATE REL TABLE `User_belongsToDepartment_Group` (FROM `User` TO `Group`, MANY_ONE);
CREATE REL TABLE `SessionGateway` (FROM `EventOnlineSession` TO `Gateway`, MANY_ONE);
CREATE REL TABLE `EventTeacherComplaint_filedBy_Student` (FROM `EventTeacherComplaint` TO `Student`, MANY_ONE);
CREATE REL TABLE `TeacherEducation_belongsTo_Teacher` (FROM `TeacherEducation` TO `Teacher`, MANY_ONE);
CREATE REL TABLE `Post_belongsToOrg_Group` (FROM `Post` TO `Group`, MANY_MANY);
CREATE REL TABLE `EventTeacherDiscipline_imposedOn_Teacher` (FROM `EventTeacherDiscipline` TO `Teacher`, MANY_ONE);
CREATE REL TABLE `EventCardConsume_performedBy_Student` (FROM `EventCardConsume` TO `Student`, MANY_ONE);
CREATE REL TABLE `SessionNAS` (FROM `EventOnlineSession` TO `NASDevice`, MANY_ONE);
CREATE REL TABLE `SessionAccessDevice` (FROM `EventOnlineSession` TO `AccessDevice`, MANY_ONE);
CREATE REL TABLE `UserIPAddress` (FROM `User` TO `IPAddress`, MANY_MANY);
CREATE REL TABLE `EventTeacherComplaint_complainedAgainst_Teacher` (FROM `EventTeacherComplaint` TO `Teacher`, MANY_ONE);
CREATE REL TABLE `SessionArea` (FROM `EventOnlineSession` TO `Area`, MANY_ONE);
CREATE REL TABLE `SessionTerminal` (FROM `EventOnlineSession` TO `TerminalDevice`, MANY_ONE);
CREATE REL TABLE `SessionOperator` (FROM `EventOnlineSession` TO `Operator`, MANY_ONE);
CREATE REL TABLE `User_belongsToRegion_Label` (FROM `User` TO `Label`, MANY_MANY);
CREATE REL TABLE `Group_hasParent_Group` (FROM `Group` TO `Group`, MANY_ONE);
CREATE REL TABLE `SessionService` (FROM `EventOnlineSession` TO `Service`, MANY_ONE);
CREATE REL TABLE `SessionAP` (FROM `EventOnlineSession` TO `NetworkAccessPoint`, MANY_ONE);
CREATE REL TABLE `SessionUser` (FROM `EventOnlineSession` TO `User`, MANY_ONE);